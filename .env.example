# Copy this file to .env and add one or more provider credentials.
# Never commit real credentials. ProofBench does not expose keys in its API.

# --- Provider credentials (at least one recommended) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Gemini also accepts GEMINI_API_KEY if that is your preferred variable name.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI-compatible endpoint (local inference or hosted gateway).
# Examples: http://localhost:11434/v1 for Ollama's OpenAI-compatible API.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Optional: replace the default model catalog with model IDs available to your account.
PROOFBENCH_OPENAI_MODELS=gpt-4o-mini,gpt-4.1-mini
PROOFBENCH_GEMINI_MODELS=gemini-3.5-flash-lite
PROOFBENCH_ANTHROPIC_MODELS=claude-3-5-haiku-latest,claude-3-7-sonnet-latest
PROOFBENCH_COMPATIBLE_MODELS=llama3.1

# Optional server behavior.
PROOFBENCH_DB_PATH=./data/proofbench.db
PROOFBENCH_REQUEST_TIMEOUT=60
PROOFBENCH_MAX_TOOL_ROUNDS=4

# Optional: pricing overrides in USD per 1 million tokens.
# Values are illustrative examples only. Update them to the current model rate card.
# The JSON must be one line and model IDs must exactly match the catalog.
# PROOFBENCH_MODEL_PRICING_JSON={"gpt-4o-mini":{"input_per_1m":0.15,"output_per_1m":0.6},"gemini-2.5-flash":{"input_per_1m":0.3,"output_per_1m":2.5}}
